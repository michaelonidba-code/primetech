# Copy to deploy/.env (git-ignored) and fill in. Values need no quoting.

# Public DNS name of this host. Caddy gets a Let's Encrypt certificate for it.
DASHBOARD_DOMAIN=ads.example.com

# Users, comma-separated. Create each entry with:
#   cd dashboard && npm run hash-password -- <user>
# or, without Node installed (after building the images):
#   docker compose run --rm --no-deps dashboard node --experimental-strip-types tools/scripts/hash-password.ts <user>
DASHBOARD_USERS=

# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
DASHBOARD_SESSION_SECRET=

# Shared secret between Alertmanager and the dashboard's alert webhook: `openssl rand -base64 32`.
ALERT_WEBHOOK_TOKEN=

# Grafana admin password (Grafana is not exposed publicly; see README "Observability").
GRAFANA_ADMIN_PASSWORD=

# Optional: alert notifications on installed apps. Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
