  {
   "type": "table",
   "title": "Firing alerts",
   "id": 33,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 56,
    "w": 24,
    "h": 8
   },
   "description": "Alerts Prometheus is firing now. Alertmanager groups them, holds back symptoms of a firing cause, and notifies the dashboard app, which pushes them to subscribed devices.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "alertstate": true,
       "instance": true
      },
      "indexByName": {
       "severity": 0,
       "alertname": 1,
       "check": 2,
       "job": 3
      },
      "renameByName": {}
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No alerts firing"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "severity"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "critical": {
            "color": "red",
            "text": "critical"
           },
           "warning": {
            "color": "orange",
            "text": "warning"
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  }
