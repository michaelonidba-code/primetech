{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "ad_events",
      "timestampSpec": { "column": "eventTimeMs", "format": "millis" },
      "dimensionsSpec": {
        "dimensions": [
          "type",
          "advertiserId",
          "advertiserName",
          "campaignId",
          "campaignName",
          "lineItemId",
          "creativeId",
          "deviceType",
          "country",
          { "type": "long", "name": "ivt" },
          "ivtReason",
          { "type": "long", "name": "consent" }
        ]
      },
      "metricsSpec": [
        { "type": "count", "name": "events" },
        { "type": "longSum", "name": "priceMicros", "fieldName": "priceMicros" },
        { "type": "HLLSketchBuild", "name": "devices", "fieldName": "deviceIdHash", "lgK": 12 }
      ],
      "granularitySpec": {
        "segmentGranularity": "hour",
        "queryGranularity": "minute",
        "rollup": true
      }
    },
    "ioConfig": {
      "type": "kafka",
      "topic": "ad-events-clean.v1",
      "inputFormat": { "type": "json" },
      "consumerProperties": {
        "bootstrap.servers": "redpanda:9092",
        "isolation.level": "read_committed"
      },
      "useEarliestOffset": true,
      "taskCount": 1,
      "replicas": 1,
      "taskDuration": "PT15M",
      "completionTimeout": "PT20M"
    },
    "tuningConfig": {
      "type": "kafka",
      "maxRowsInMemory": 100000,
      "maxRowsPerSegment": 5000000
    }
  }
}
